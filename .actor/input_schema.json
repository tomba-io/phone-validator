{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Tomba Phone Validator Input",
    "description": "Input configuration for Tomba Phone Validator Actor - Validate phone numbers and retrieve associated information",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "phoneNumbers": {
            "title": "Phone Numbers",
            "type": "array",
            "editor": "json",
            "description": "Array of phone number objects with phoneNumber and optional countryCode",
            "items": {
                "type": "object",
                "properties": {
                    "phoneNumber": {
                        "title": "Phone Number",
                        "type": "string",
                        "minLength": 10,
                        "maxLength": 20,
                        "description": "Phone number to validate"
                    },
                    "countryCode": {
                        "title": "Country Code",
                        "type": "string",
                        "pattern": "^[A-Z]{2}$",
                        "description": "Optional ISO country code (e.g., 'US', 'GB', 'FR')"
                    }
                },
                "required": ["phoneNumber"],
                "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 1000,
            "example": [
                {
                    "phoneNumber": "+1 (555) 123-4567"
                },
                {
                    "phoneNumber": "+33 6 12 34 56 78",
                    "countryCode": "FR"
                },
                {
                    "phoneNumber": "07911 123456",
                    "countryCode": "GB"
                },
                {
                    "phoneNumber": "+81 90-1234-5678"
                }
            ],
            "prefill": [
                {
                    "phoneNumber": "+1 (555) 123-4567"
                }
            ]
        },
        "maxResults": {
            "title": "Maximum Results",
            "type": "integer",
            "description": "Maximum number of phone numbers to validate",
            "minimum": 1,
            "maximum": 10000,
            "default": 50,
            "example": 100,
            "editor": "number"
        },
        "maxConcurrency": {
            "title": "Max concurrency",
            "type": "integer",
            "description": "How many Tomba requests run in parallel. There is no rate limit, so raise it for large lists.",
            "minimum": 1,
            "maximum": 50,
            "default": 10,
            "editor": "number",
            "sectionCaption": "Run options",
            "sectionDescription": "Concurrency, retry and cache settings. The defaults work well for most runs."
        },
        "maxRetries": {
            "title": "Max retries",
            "type": "integer",
            "description": "How many times to retry a request after a network error, 429 or 5xx response (exponential backoff). Failed requests are never charged.",
            "minimum": 0,
            "maximum": 10,
            "default": 3,
            "editor": "number"
        },
        "useCache": {
            "title": "Use cache",
            "type": "boolean",
            "description": "Reuse results from previous runs for identical requests. Cached results are free.",
            "default": true,
            "editor": "checkbox"
        },
        "cacheTtlHours": {
            "title": "Cache TTL (hours)",
            "type": "integer",
            "description": "How long cached results stay valid. 0 disables the cross-run cache.",
            "minimum": 0,
            "maximum": 720,
            "default": 24,
            "editor": "number",
            "unit": "hours"
        }
    },
    "required": ["phoneNumbers"],
    "additionalProperties": false
}
